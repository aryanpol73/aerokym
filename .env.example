# Copy to .env (git-ignored) and fill in. Only live mode needs this file.

# OpenSky API client (https://opensky-network.org -> Account -> API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box lamin,lomin,lamax,lomax. Default covers India (4 credits per poll).
OPENSKY_BBOX=6,68,36,98
# Daily credit budget. Registered accounts get 4000; stay a little below.
OPENSKY_DAILY_CREDITS=3600

# Hours of raw positions kept in live mode.
AEROKYM_POSITIONS_RETENTION_HOURS=48

# adsb.lol API key (optional). Without a key the limit is 500 requests/day.
ADSBLOL_API_KEY=
# Daily request budget. Use 450 without a key, 900 with a free adhoc key (1000/day).
ADSBLOL_DAILY_REQUESTS=450
